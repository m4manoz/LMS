# Copy to ~/kalash/lms/.env on the server (the bootstrap script already did this with generated secrets).
DB_PASSWORD=change-me
AUTH_SIGNING_KEY=change-me-at-least-32-characters-long
PLATFORM_PROVISIONING_KEY=change-me
PUBLIC_URL=http://SERVER_IP:8081
WEB_PORT=8081

# Live classes (LiveKit). Uncomment and fill in to run a LiveKit server next to the app, then open ports 7880/tcp, 7881/tcp and 7882/udp.
# Make the key and secret with:  echo "APIlms$(openssl rand -hex 4)"; openssl rand -hex 24      (the secret must be at least 32 characters)
# Then, in the app, Integrations -> Live classes -> LiveKit: address ws://SERVER_IP:7880, and the same key and secret.
# Cameras and microphones need https:// (or localhost); on a plain http:// test address allow the address in each browser (see docs/livekit-deploy.md).
# COMPOSE_PROFILES=live
# LIVEKIT_NODE_IP=SERVER_IP
# LIVEKIT_API_KEY=APIlms00000000
# LIVEKIT_API_SECRET=change-me-at-least-32-characters-long
